# Copy to .env at repository root for Docker Compose.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
POSTGRES_PASSWORD=change-this-local-password
S3_ACCESS_KEY=memoryvault-local
S3_SECRET_KEY=change-this-local-storage-password
S3_BUCKET=memoryvault
EMBEDDING_BACKEND=sentence-transformers
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Set only for a compatible provider or Ollama. Never switch providers silently.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
