# Local PowerShell setup: copy this file to .env.local.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
STORAGE_BACKEND=local
EMBEDDING_BACKEND=disabled
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
# Optional OpenAI-compatible service or Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# OCR_LANGUAGE=eng
# LIBREOFFICE_CMD=C:/Program Files/LibreOffice/program/soffice.com
# Document limits (raising uploads also requires updating the web/proxy limits):
# MAX_UPLOAD_MB=100
# MAX_DOCUMENT_PAGES=3000
# MAX_EXTRACTED_CHARS=20000000
# MAX_DOCUMENT_CHUNKS=25000
# MAX_OCR_PAGES=1000
# DOCUMENT_JOB_TIMEOUT_SECONDS=3600
